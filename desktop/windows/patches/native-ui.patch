+bool CapturePad(int port, const input::Pad& pad) {
+    if (port < 0 || port >= 4) return false;
+    std::lock_guard<std::mutex> guard(g_pad_lock);
+    const input::Pad& old = g_pad_previous[port];
+    if (SettingsOpen()) g_pad_blocked[port] = true;
+    auto held = [](const input::Pad& v) {
+        if (v.buttons || std::abs(v.lx) > 8000 || std::abs(v.ly) > 8000 ||
+            std::abs(v.rx) > 8000 || std::abs(v.ry) > 8000) return true;
+        for (uint8_t b : v.analog) if (b != 0) return true; // partial triggers must also release before returning to play
+        return false;
+    };
+    if (g_pad_blocked[port] && !SettingsOpen() && !held(pad)) g_pad_blocked[port] = false;
+    if (SettingsOpen() && port == 0) {
+        const size_t prior_edges = g_pad_edge_count;
+        auto button = [&](uint16_t bit, int edge) { if ((pad.buttons & bit) && !(old.buttons & bit)) QueuePadEdge(edge); };
+        button(0x0001, -1); button(0x0002, 1);
+        if ((pad.ly > 16000) && old.ly <= 16000) QueuePadEdge(-1);
+        if ((pad.ly < -16000) && old.ly >= -16000) QueuePadEdge(1);
+        if ((pad.lx > 16000) && old.lx <= 16000) QueuePadEdge(2);
+        if ((pad.lx < -16000) && old.lx >= -16000) QueuePadEdge(-2);
+        button(0x0004, -2); button(0x0008, 2);
+        if (Pressed(pad, old, 0)) QueuePadEdge(3);
+        if (Pressed(pad, old, 1)) QueuePadEdge(4);
+        if (g_pad_edge_count != prior_edges) LOGR("ui: physical/scripted pad edge captured for settings navigation");
+    }
+    g_pad_previous[port] = pad;
+    return SettingsOpen() || g_pad_blocked[port];
+}
+
 }  // namespace overlay
