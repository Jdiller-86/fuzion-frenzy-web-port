diff --git a/runtime/gpu/ui_replacements.h b/runtime/gpu/ui_replacements.h
new file mode 100644
--- /dev/null
+++ b/runtime/gpu/ui_replacements.h
@@ -0,0 +1,24 @@
+#pragma once
+// Three local UI textures only. No guest address or resource pointer is retained.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <vector>
+#include "gpu/texture.h"
+struct ImFont;
+
+namespace gpu {
+struct UiReplacement {
+    uint32_t format = 0, width = 0, height = 0, physical_width = 0, physical_height = 0;
+    std::vector<uint8_t> original, pixels; // owned, tightly packed BGRA8, straight alpha
+};
+const std::array<UiReplacement, 3>& UiAssets();
+const UiReplacement* MatchUiReplacement(const TextureDesc&, const FormatInfo&,
+                                      const std::vector<uint8_t>& decoded, uint32_t pitch);
+const char* UiReplacementMode();
+uint64_t UiAssetTexture(unsigned slot);
+void SetUiAssetTexture(unsigned slot, uint64_t handle);
+uint64_t UiReplacementHits(unsigned slot);
+ImFont* UiDevelopmentFont();
+void SetUiDevelopmentFont(ImFont*);
+}
diff --git a/runtime/gpu/ui_replacements.cpp b/runtime/gpu/ui_replacements.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/gpu/ui_replacements.cpp
@@ -0,0 +1,74 @@
+#include "gpu/ui_replacements.h"
+#include "core/log.h"
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+
+namespace gpu {
+namespace {
+std::array<UiReplacement, 3> assets;
+std::atomic<uint64_t> handles[3]{}, hits[3]{};
+std::once_flag loaded;
+int mode = 0; // immutable for this process: off, identity, pilot
+ImFont* development_font = nullptr; // owned by the app's ImGui atlas; render-thread use only
+bool U32(std::ifstream& f, uint32_t& n) {
+    uint8_t b[4]; if (!f.read(reinterpret_cast<char*>(b), 4)) return false;
+    n = uint32_t(b[0]) | uint32_t(b[1]) << 8 | uint32_t(b[2]) << 16 | uint32_t(b[3]) << 24;
+    return true;
+}
+void Load() {
+    const char* setting = std::getenv("FUZION_UI_REPLACE");
+    if (setting && !std::strcmp(setting, "identity")) mode = 1;
+    if (setting && !std::strcmp(setting, "pilot")) mode = 2;
+    const char* file = std::getenv("FUZION_UI_PACK");
+    if (!file || !*file) { LOGR("ui replacements: no local pack; original textures retained"); return; }
+    std::ifstream f(file, std::ios::binary | std::ios::ate);
+    if (!f || f.tellg() > (8 << 20) || f.tellg() < 16) { LOGW("ui replacements: invalid/missing pack"); return; }
+    f.seekg(0);
+    char magic[8]; uint32_t count;
+    if (!f.read(magic, 8) || std::memcmp(magic, "FUIBGRA1", 8) || !U32(f, count) || count != 3) return;
+    std::array<UiReplacement, 3> admitted;
+    constexpr uint32_t widths[]{128,32,256}, heights[]{128,32,64}, formats[]{0x0B,0x0B,0x02};
+    for (unsigned i = 0; i < 3; ++i) {
+        auto& a = admitted[i]; uint32_t slot, original_bytes, replacement_bytes;
+        if (!U32(f,slot) || !U32(f,a.format) || !U32(f,a.width) || !U32(f,a.height) ||
+            !U32(f,a.physical_width) || !U32(f,a.physical_height) || !U32(f,original_bytes) || !U32(f,replacement_bytes)) return;
+        if (slot != i || a.format != formats[i] || a.width != widths[i] || a.height != heights[i] ||
+            a.physical_width < a.width || a.physical_height < a.height ||
+            a.physical_width > a.width * 4 || a.physical_height > a.height * 4 ||
+            a.physical_width * a.height != a.physical_height * a.width ||
+            original_bytes != a.width * a.height * 4 || replacement_bytes != a.physical_width * a.physical_height * 4) return;
+        a.original.resize(original_bytes); a.pixels.resize(replacement_bytes);
+        if (!f.read(reinterpret_cast<char*>(a.original.data()), original_bytes) ||
+            !f.read(reinterpret_cast<char*>(a.pixels.data()), replacement_bytes)) return;
+        if (mode != 2) { a.pixels = a.original; a.physical_width = a.width; a.physical_height = a.height; }
+    }
+    if (f.peek() != std::char_traits<char>::eof()) return;
+    assets = std::move(admitted);
+    LOGR("ui replacements: admitted three local BGRA assets; mode=%s, single mip, immutable until restart", mode == 2 ? "pilot" : mode == 1 ? "identity" : "off");
+}
+}
+const std::array<UiReplacement, 3>& UiAssets() { std::call_once(loaded, Load); return assets; }
+const char* UiReplacementMode() { UiAssets(); return mode == 2 ? "pilot" : mode == 1 ? "identity" : "off"; }
+uint64_t UiAssetTexture(unsigned slot) { return slot < 3 ? handles[slot].load() : 0; }
+void SetUiAssetTexture(unsigned slot, uint64_t handle) { if (slot < 3) handles[slot].store(handle); }
+uint64_t UiReplacementHits(unsigned slot) { return slot < 3 ? hits[slot].load() : 0; }
+ImFont* UiDevelopmentFont() { return development_font; }
+void SetUiDevelopmentFont(ImFont* font) { development_font = font; }
+const UiReplacement* MatchUiReplacement(const TextureDesc& d, const FormatInfo& fi,
+                                      const std::vector<uint8_t>& px, uint32_t pitch) {
+    UiAssets();
+    if (!mode || fi.host != Host::BGRA8 || fi.depth || fi.compressed || d.cube || d.linear ||
+        d.depth != 1 || d.levels != 1 || pitch != d.width * 4) return nullptr;
+    for (unsigned i = 0; i < 3; ++i) {
+        const auto& a = assets[i];
+        // Full decoded bytes include palette colours and alpha. A changed palette fails the match.
+        if (d.format == a.format && d.width == a.width && d.height == a.height && !px.empty() && px == a.original) {
+            if (!hits[i].fetch_add(1)) LOGR("ui replacement: slot %u exact content+descriptor match, guest %ux%u -> physical %ux%u", i, d.width,d.height,a.physical_width,a.physical_height);
+            return &a;
+        }
+    }
+    return nullptr;
+}
+}
