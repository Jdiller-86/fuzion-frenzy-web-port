+ComPtr<ID3D12Resource> D3D12Backend::MakeUiTexture(const UiReplacement& asset) {
+    if (asset.pixels.empty()) return {};
+    Tex tx;
+    tx.levels = 1;
+    D3D12_HEAP_PROPERTIES hp{D3D12_HEAP_TYPE_DEFAULT};
+    D3D12_RESOURCE_DESC td{};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = asset.physical_width; td.Height = asset.physical_height;
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+    if (FAILED(dev_->CreateCommittedResource(&hp,D3D12_HEAP_FLAG_NONE,&td,D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_PPV_ARGS(&tx.res)))) return {};
+    if (!UploadTextureLevel(tx,0,0,asset.pixels,asset.physical_width * 4)) return {};
+    D3D12_RESOURCE_STATES st = D3D12_RESOURCE_STATE_COPY_DEST;
+    Transition(tx.res.Get(),st,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    return tx.res;
+}
