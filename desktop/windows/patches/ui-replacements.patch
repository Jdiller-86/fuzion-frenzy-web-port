+void D3D12Backend::InitUiAssets() {
+    const auto& assets = UiAssets();
+    for (unsigned i = 0; i < assets.size(); ++i) {
+        SetUiAssetTexture(i,0);
+        ui_assets_[i] = MakeUiTexture(assets[i]);
+        if (!ui_assets_[i]) continue;
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv{};
+        sv.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sv.Texture2D.MipLevels = 1;
+        auto cpu = ui_heap_->GetCPUDescriptorHandleForHeapStart();
+        auto gpu = ui_heap_->GetGPUDescriptorHandleForHeapStart();
+        cpu.ptr += (i + 1) * srv_inc_; gpu.ptr += (i + 1) * srv_inc_;
+        dev_->CreateShaderResourceView(ui_assets_[i].Get(),&sv,cpu);
+        SetUiAssetTexture(i,gpu.ptr);
+    }
 }
 
